{
    "name": "tesis-facturacion-root",
    "version": "1.0.0",
    "description": "Orquestador principal para Alito Group Facturación",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:dev": "vite build --mode development",
        "preview": "vite preview",
        "lint": "eslint .",
        "install:backend": "powershell -ExecutionPolicy Bypass -File ./install-dependencies.ps1",
        "dev:legacy-frontend": "cd sistema_facturacion/web-app && npm run dev",
        "dev:identity": "cd sistema_facturacion/services/identity-service && npm run start:dev",
        "dev:master": "cd sistema_facturacion/services/master-data-service && npm run start:dev",
        "dev:billing": "cd sistema_facturacion/services/billing-service && npm run start:dev",
        "dev:quotation": "cd sistema_facturacion/services/quotation-service && npm run start:dev",
        "dev:ar": "cd sistema_facturacion/services/ar-service && npm run start:dev",
        "start:all": "powershell -ExecutionPolicy Bypass -File ./start-backend.ps1",
        "supabase:start": "supabase start",
        "supabase:stop": "supabase stop",
        "supabase:reset": "supabase db reset"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toast": "^1.2.15",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@supabase/supabase-js": "^2.90.1",
        "@tanstack/react-query": "^5.90.17",
        "@vitejs/plugin-react-swc": "^4.2.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "lovable-tagger": "^1.1.13",
        "lucide-react": "^0.562.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-router-dom": "^7.12.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@types/react": "^19.2.8",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.18.0",
        "postcss": "^8.5.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.3",
        "vite": "^5.4.10"
    }
}
